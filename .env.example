# Language / 语言: zh_CN or en_US
LANGUAGE=zh_CN

# Robinhood Chain mainnet RPC
# Primary endpoint / 主 RPC
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional comma-separated backup RPCs / 可选备用 RPC，逗号分隔
RH_RPC_URLS=
# Probe primary again after failover / 故障切换后多久尝试切回主 RPC
RPC_FAILBACK_SEC=300
# Local read-only failover proxy, localhost only / 本地容灾代理，仅监听本机
RPC_PROXY_PORT=18766

# Primary $1M alerts
ALERT_USD=1000000
CUM_ALERT_USD=1000000
CUM_WINDOW_MIN=10

# Address intelligence thresholds
INTEL_CORRELATION_WINDOW_MIN=60
FRESH_WALLET_MAX_TX_COUNT=3
INTEL_BRIDGE_MIN_USD=100000
INTEL_LP_MIN_USD=100000
INTEL_SWAP_MIN_USD=100000

# V1.3 Token Early-Capital Radar
TOKEN_RADAR_MIN_EVENT_USD=100000
TOKEN_SIGNAL_MIN_SCORE=55
TOKEN_CORRELATION_WINDOW_MIN=180
TOKEN_DEEP_SCAN_TTL_SEC=600
TOKEN_SIGNAL_COOLDOWN_MIN=30

# V1.3.1 LP Rug Radar
# Percentages are based on Radar-observed large-LP net flow, not exact pool TVL.
LP_RUG_MIN_REMOVE_USD=250000
LP_RUG_ABSOLUTE_USD=1000000
LP_RUG_P0_DRAIN_PCT=50
LP_RUG_P1_DRAIN_PCT=30
LP_RUG_BASELINE_MIN_USD=500000
LP_RUG_WINDOW_HOURS=24
LP_RUG_COOLDOWN_MIN=15

# Scanner / pipeline
POLL_SECONDS=2
BLOCK_CHUNK=50
START_BACKFILL_BLOCKS=20
CONFIRMATIONS=0
FAST_SCAN_CHUNK=5000
FAST_SCAN_MIN_CHUNK=100
FAST_SCAN_POLL_SECONDS=0.35
WORKER_IDLE_SECONDS=0.12
SWAP_FILTER_MAX_WORKERS=3
SWAP_FILTER_BATCH_SIZE=24
SWAP_FILTER_IDLE_SECONDS=0.06
SWAP_PREFILTER_MIN_USD=80000
SWAP_SHADOW_SAMPLE_EVERY=200
NATIVE_SCAN_CHUNK=80
NATIVE_SCAN_MIN_CHUNK=10
NATIVE_HISTORY_WINDOW_BLOCKS=1000
NATIVE_FAST_FORWARD_ON_START=1

# Supervisor / freshness
SUPERVISOR_SCANNER_STALE_SEC=180
SUPERVISOR_MAX_RSS_MB=700
MAINTENANCE_INTERVAL_SEC=60
SWAP_BACKLOG_MAX=50000
SWAP_MAX_AGE_MIN=30
FAST_MAX_AGE_MIN=30

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard: localhost only by default
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Official Uniswap deployments (chain 4663)
UNISWAP_V2_FACTORY=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
UNISWAP_V3_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
UNISWAP_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
UNISWAP_V4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
UNISWAP_V4_POSITION_MANAGER=0x58daec3116aae6d93017baaea7749052e8a04fa7

# Official Robinhood canonical L2 bridge contracts
L2_GATEWAY_ROUTER=0x1e324b9316138ca9a73f960213621ad1aaf01b89
L2_ERC20_GATEWAY=0xfd9b17206278c16ddaacf6ac8f05dbf97edcb31e
L2_CUSTOM_GATEWAY=0x912285144fc0f6e89d3ed16f5ab72f87a1878959
L2_WETH_GATEWAY=0x1d187c3e2da52d72bc9c41e3aba0fdfa6a7bf055
WETH_ADDRESS=0x0bd7d308f8e1639fab988df18a8011f41eacad73
USDG_ADDRESS=0x5fc5360d0400a0fd4f2af552add042d716f1d168

# Optional comma-separated verified bridge adapter addresses
PARTNER_BRIDGE_ADDRESSES=
LOG_LEVEL=INFO

# Optional custom SQLite path / 可选自定义数据库路径
# DB_PATH=/opt/robinhood-chain-radar/radar.db
